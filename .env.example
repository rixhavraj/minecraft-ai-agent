APP_ENV=development
LOG_LEVEL=info
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=minecraft_ai_squad

# Configure these before enabling the related integration phases.
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=
MINECRAFT_VERSION=
MINECRAFT_USERNAME=
MINECRAFT_WORLD_ID=
MINECRAFT_AUTH=offline
MINECRAFT_PLAYER_NAME=
# JSON array for multiple bots. Leave empty to use the single bot above.
MINECRAFT_BOTS=[]

TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
TELEGRAM_GROUP_ID=

OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
MODEL_PROVIDER=auto
MODEL_PROVIDER_ORDER=groq,openrouter,google,ollama,huggingface
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.8-flash
OLLAMA_MODEL=llama3.1:8b
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# Autonomous idle behavior is opt-in and always uses the central task executor.
AUTONOMY_ENABLED=false
AUTONOMY_INTERVAL_MS=30000

DASHBOARD_ENABLED=false
DASHBOARD_PORT=8787
TASK_RECOVERY_ENABLED=false
